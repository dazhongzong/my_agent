{
  "name": "my-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import=tsx src/index.ts",
    "dev:watch": "node --watch --env-file=.env --import=tsx src/index.ts",
    "build": "tsc --project tsconfig.json",
