    "start": "node --env-file=.env dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "openai": "^7.8.0"
  }
}
